<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="laser_xacro" params="xyz">
        <link name="laser_cylinder_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>    
                </geometry>
                <material name="White">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
            </visual>
            <collision> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.01" length="0.10"/>    
                </geometry>
                <material name="White">
                    <color rgba="1.0 1.0 1.0 1.0"/>
                </material>
            </collision>
        </link>
        <link name="laser_link">
            <visual>
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>    
                </geometry>
                <material name="White">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </visual>
            <collision> 
                <origin rpy="0 0 0" xyz="0 0 0"/>
                <geometry>
                    <cylinder radius="0.02" length="0.02"/>    
                </geometry>
                <material name="White">
                    <color rgba="0.0 0.0 0.0 0.5"/>
                </material>
            </collision>
        </link>
        <joint name="laser_joint" type="fixed">
            <parent link="laser_cylinder_link"/>
            <child link="laser_link"/>
            <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
        </joint>

        <joint name="laser_cyblinder_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser_cylinder_link"/>
            <origin xyz="${xyz}" rpy="0.0 0.0 0.0"/>
        </joint>      
    </xacro:macro>
</robot>